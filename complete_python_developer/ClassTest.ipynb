    "class Cat:\n",
    "\n",
    "    def __init__(self, name, age):\n",
    "            self.name = name\n",
    "            self.age = age\n",
    "\n",
    "    def showMessage(self):\n",
    "         print(f'The Name is {self.name} and the age is {self.age}')\n",
    "\n",
    "\n",
    "tom = Cat('nirmal',45)\n",
    "print(tom.showMessage())\n",
    "\n",
    "\n",
    "    "
